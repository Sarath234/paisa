# paisa-agent.yaml — copy to ~/.config/paisa-agent/paisa-agent.yaml and fill in your values

paisa:
  url: http://localhost:7500
  journal_dir: /path/to/your/journal   # directory containing your .ledger files

ollama:
  url: http://localhost:11434
  model: gemma3:4b                     # or gemma3:12b for better accuracy

telegram:
  bot_token: "YOUR_BOT_TOKEN"          # from @BotFather
  chat_id: 123456789                   # your personal chat ID (get from @userinfobot)

parser_rules:

  # ── Account entries ────────────────────────────────────────────────────────
  # Each entry has:
  #   bank:        format key (icici_cc | hdfc_debit | hdfc_cc | axis_checking |
  #                             axis_cc | idfc_checking | fi_checking | jupiter | fixed)
  #   identifiers: ALL substrings must appear in the SMS (AND match)
  #   destinations: ledger account for the journal first line (explicit amount)
  #   src:         (fixed routes only) where money flows from (journal second line)
  #   description: (fixed routes only) journal description line
  #
  # Put fixed routes BEFORE format entries so they win when a message matches both.
  accounts:

    # ── Fixed routes ────────────────────────────────────────────────────────

    - bank: fixed
      identifiers: ["CRD-PMNT", "8860"]
      src: "Assets:Checking:YOUR_CHECKING"
      destinations: "Liabilities:CreditCard:YOUR_CC"
      description: "CC Payment"

    # ── Format entries ──────────────────────────────────────────────────────

    - bank: icici_cc
      identifiers: ["ICICI Bank Card XX6009"]
      destinations: "Liabilities:CreditCard:ICIC6009"

    - bank: hdfc_debit
      identifiers: ["HDFC Bank Card 2148"]
      destinations: "Assets:Checking:HDFC2148"

    - bank: hdfc_cc
      identifiers: ["HDFC Bank Card 2527"]
      destinations: "Liabilities:CreditCard:HDFC2527"

    - bank: axis_checking
      identifiers: ["A/c no. XX6386"]
      destinations: "Assets:Checking:AXIS6386"

    - bank: axis_cc
      identifiers: ["Card no. XX8860"]
      destinations: "Liabilities:CreditCard:AXIS8860"

    - bank: idfc_checking
      identifiers: ["XX6977"]
      destinations: "Assets:Checking:IDFC6977"

  # ── Merchant routing rules ─────────────────────────────────────────────────
  # keyword: case-insensitive substring match against the extracted merchant name
  # Checked in order; first match wins. Add custom entries at the top to override.

  merchants:
    # Food
    - keyword: "swiggy"
      account: "Expenses:Food:Hyd"
      description: "Food Swiggy"
    - keyword: "zomato"
      account: "Expenses:Food:Hyd"
      description: "Food Zomato"

    # Groceries
    - keyword: "blinkit"
      account: "Expenses:Groceries:Hyd"
      description: "Groceries Blink"
    - keyword: "zepto"
      account: "Expenses:Groceries:Hyd"
      description: "Groceries ZEPTO"
    - keyword: "bigbasket"
      account: "Expenses:Groceries:Hyd"
      description: "Groceries BigBasket"

    # Commute
    - keyword: "uber"
      account: "Expenses:Commute:Hyd"
      description: "Commute: Uber"

    # Travel
    - keyword: "irctc"
      account: "Expenses:Travel:Hyd"
      description: "Travel"

    # Shopping
    - keyword: "amazon"
      account: "Expenses:Shopping:Hyd"
      description: "Shopping: Amazon"
    - keyword: "flipkart"
      account: "Expenses:Shopping:Hyd"
      description: "Shopping: Flipkart"

    # Income
    - keyword: "monthly interest"
      account: "Income:Interest:IDFC6977"
      description: "Bank Interest"
    - keyword: "interest"
      account: "Income:Interest"
      description: "Bank Interest"
    - keyword: "salary"
      account: "Income:Salary"
      description: "Salary"
